# COLLECTOR-01 deterministic read-only KPM collector.

TCD_KPM_NODE_TYPE=gNB_DU

# Optional. Leave unset when exactly one node of the selected type exists.
# Canonical examples:
# TCD_KPM_NODE_ID=nb_id=2
# TCD_KPM_NODE_ID=nb_id=2;cu_du_id=2

TCD_KPM_REQUIRE_EXACTLY_ONE_MATCH=true
TCD_KPM_DISCOVERY_TIMEOUT_SECONDS=10
TCD_KPM_DISCOVERY_POLL_MS=200

# Must equal the `time` value of the single matching KPM profile in the
# FlexRIC xApp configuration.
TCD_KPM_SUBSCRIPTION_PERIOD_MS=1000

# At least one runtime bound must be non-zero.
TCD_KPM_MAX_INDICATIONS=10
TCD_KPM_DURATION_SECONDS=30

# Prints only the final copied record after callback removal and API shutdown.
# No diagnostic printing is performed inside the callback.
TCD_KPM_STRUCTURED_DEBUG_STDERR=false
