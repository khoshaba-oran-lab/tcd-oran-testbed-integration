+static
+void tcd_kpm_struct_trace_indication(
+    kpm_ind_data_t const* const kpm,
+    uint64_t const indication_index,
+    bool const receive_timestamp_valid,
+    uint64_t const receive_timestamp_ns)
+{
+  if(kpm == NULL) {
+    tcd_kpm_struct_trace_error(
+        indication_index,
+        "kpm_indication",
+        "null_pointer");
+
+    return;
+  }
+
+  int const message_format = kpm->msg.type;
+
+  size_t ue_report_count = 0;
+  bool ue_report_count_known = true;
+
+  switch(message_format) {
+    case FORMAT_1_INDICATION_MESSAGE:
+      ue_report_count = 0;
+      break;
+
+    case FORMAT_3_INDICATION_MESSAGE:
+      ue_report_count =
+          kpm->msg.frm_3.ue_meas_report_lst_len;
+      break;
+
+    default:
+      ue_report_count_known = false;
+      break;
+  }
+
+  tcd_kpm_struct_trace_begin(
+      "indication",
+      indication_index);
+
+  if(receive_timestamp_valid) {
+    fprintf(
+        stderr,
+        ",\"receive_timestamp_unix_ns\":%" PRIu64,
+        receive_timestamp_ns);
+  } else {
+    fputs(
+        ",\"receive_timestamp_unix_ns\":null",
+        stderr);
+  }
+
+  fprintf(
+      stderr,
+      ",\"kpm_header_timestamp_raw\":%" PRIu64 ","
+      "\"kpm_header_timestamp_unit\":\"raw\","
+      "\"message_format\":%d",
+      (uint64_t)kpm
+          ->hdr
+          .kpm_ric_ind_hdr_format_1
+          .collectStartTime,
+      message_format);
+
+  if(ue_report_count_known)
+    fprintf(stderr, ",\"ue_report_count\":%zu", ue_report_count);
+  else
+    fputs(",\"ue_report_count\":null", stderr);
+
+  tcd_kpm_struct_trace_end();
+
+  switch(message_format) {
+    case FORMAT_1_INDICATION_MESSAGE:
+      tcd_kpm_struct_trace_format_1(
+          &kpm->msg.frm_1,
+          indication_index,
+          message_format,
+          false,
+          0);
+
+      break;
+
+    case FORMAT_3_INDICATION_MESSAGE:
+      tcd_kpm_struct_trace_format_3(
+          &kpm->msg.frm_3,
+          indication_index,
+          message_format);
+
+      break;
+
+    default:
+      tcd_kpm_struct_trace_error(
+          indication_index,
+          "indication_message",
+          "unsupported_format");
+
+      break;
+  }
+}
