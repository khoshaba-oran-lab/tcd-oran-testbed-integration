+      tcd_kpm_struct_trace_error(
+          indication_index,
+          "meas_info_lst",
+          "index_out_of_range");
+
+      break;
+    }
+
+    int const descriptor_type =
+        msg_frm_1->meas_info_lst[info_index].meas_type.type;
