+#define TCD_KPM_STRUCT_TRACE_ENV "TCD_KPM_STRUCT_TRACE"
+#define TCD_KPM_STRUCT_TRACE_TYPE "kpm_struct"
+#define TCD_KPM_STRUCT_TRACE_STRING_LIMIT 256U
+
+static atomic_uint_fast64_t tcd_kpm_struct_indication_counter =
+    ATOMIC_VAR_INIT(0);
+
+static atomic_int tcd_kpm_struct_trace_enabled_cache =
+    ATOMIC_VAR_INIT(-1);
+
+static pthread_mutex_t tcd_kpm_struct_trace_output_mutex =
+    PTHREAD_MUTEX_INITIALIZER;
+
+static
+bool tcd_kpm_struct_trace_enabled(void)
+{
+  int const cached = atomic_load_explicit(
+      &tcd_kpm_struct_trace_enabled_cache,
+      memory_order_acquire);
+
+  if(cached >= 0)
+    return cached == 1;
+
+  char const* const value = getenv(TCD_KPM_STRUCT_TRACE_ENV);
+  int const detected = value != NULL && strcmp(value, "1") == 0 ? 1 : 0;
+
+  int expected = -1;
+
+  (void)atomic_compare_exchange_strong_explicit(
+      &tcd_kpm_struct_trace_enabled_cache,
+      &expected,
+      detected,
+      memory_order_release,
+      memory_order_relaxed);
+
+  return atomic_load_explicit(
+      &tcd_kpm_struct_trace_enabled_cache,
+      memory_order_acquire) == 1;
+}
+
+static
+uint64_t tcd_kpm_struct_next_indication_index(void)
+{
+  return atomic_fetch_add_explicit(
+      &tcd_kpm_struct_indication_counter,
+      UINT64_C(1),
+      memory_order_relaxed) + UINT64_C(1);
+}
+
+static
+bool tcd_kpm_struct_realtime_ns(uint64_t* const timestamp_ns)
+{
+  if(timestamp_ns == NULL)
+    return false;
+
+  struct timespec timestamp = {0};
+
+  if(clock_gettime(CLOCK_REALTIME, &timestamp) != 0)
+    return false;
+
+  if(timestamp.tv_nsec < 0 || timestamp.tv_nsec >= 1000000000L)
+    return false;
+
+  *timestamp_ns =
+      (uint64_t)timestamp.tv_sec * UINT64_C(1000000000) +
+      (uint64_t)timestamp.tv_nsec;
+
+  return true;
+}
+
+static
+bool tcd_kpm_struct_write_json_string(
+    FILE* const stream,
+    uint8_t const* const buffer,
+    size_t const length)
+{
+  if(stream == NULL)
+    return false;
+
+  if(buffer == NULL) {
+    fputs("null", stream);
+    return false;
+  }
+
+  size_t const emitted_length =
+      length < TCD_KPM_STRUCT_TRACE_STRING_LIMIT
+          ? length
+          : TCD_KPM_STRUCT_TRACE_STRING_LIMIT;
+
+  fputc('"', stream);
+
+  for(size_t i = 0; i < emitted_length; ++i) {
+    uint8_t const value = buffer[i];
+
+    switch(value) {
+      case '"':
+        fputs("\\\"", stream);
+        break;
+
+      case '\\':
+        fputs("\\\\", stream);
+        break;
+
+      case '\b':
+        fputs("\\b", stream);
+        break;
+
+      case '\f':
+        fputs("\\f", stream);
+        break;
+
+      case '\n':
+        fputs("\\n", stream);
+        break;
+
+      case '\r':
+        fputs("\\r", stream);
+        break;
+
+      case '\t':
+        fputs("\\t", stream);
+        break;
+
+      default:
+        if(value >= 0x20U && value <= 0x7eU)
+          fputc((int)value, stream);
+        else
+          fprintf(stream, "\\u%04x", (unsigned int)value);
+        break;
+    }
+  }
+
+  fputc('"', stream);
+
+  return emitted_length != length;
+}
+
+static
+void tcd_kpm_struct_trace_begin(
+    char const* const event,
+    uint64_t const indication_index)
+{
+  int const rc = pthread_mutex_lock(
+      &tcd_kpm_struct_trace_output_mutex);
+
+  if(rc != 0) {
+    fprintf(
+        stderr,
+        "TCD KPM structural trace mutex lock failed: %d\\n",
+        rc);
+
+    abort();
+  }
+
+  fputs(
+      "{\"trace_type\":\"" TCD_KPM_STRUCT_TRACE_TYPE "\","
+      "\"event\":",
+      stderr);
+
+  if(event != NULL) {
+    (void)tcd_kpm_struct_write_json_string(
+        stderr,
+        (uint8_t const*)event,
+        strlen(event));
+  } else {
+    fputs("null", stderr);
+  }
+
+  fprintf(
+      stderr,
+      ",\"indication_index\":%" PRIu64,
+      indication_index);
+}
+
+static
+void tcd_kpm_struct_trace_end(void)
+{
+  fputs("}\n", stderr);
+  fflush(stderr);
+
+  int const rc = pthread_mutex_unlock(
+      &tcd_kpm_struct_trace_output_mutex);
+
+  if(rc != 0) {
+    fprintf(
+        stderr,
+        "TCD KPM structural trace mutex unlock failed: %d\\n",
+        rc);
+
+    abort();
+  }
+}
