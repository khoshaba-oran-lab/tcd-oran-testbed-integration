USER_PLANE_READINESS_POLICY_VERSION=1

DOCTOR_MODE=strict-read-only

ACTIVE_PROBE_OWNER=scripts/sci-oran-user-plane-smoke.sh
DOCTOR_OWNER=scripts/sci-oran-doctor.sh

ACTIVE_PROBE_ALLOWED=true
DOCTOR_ACTIVE_PROBE_ALLOWED=false

TRANSIENT_TOOLBOX_ALLOWED=true
TRANSIENT_TOOLBOX_IMAGE=sci-oran/toolbox:v1
TRANSIENT_TOOLBOX_NETWORK_MODE=container:ue

DIAGNOSTIC_TRAFFIC_TYPE=icmp
DIAGNOSTIC_TRAFFIC_PACKET_COUNT=3

EXPECTED_UE_INTERFACE=tun_srsue
EXPECTED_UE_PDU_IPV4=10.45.1.2
EXPECTED_UPF_IPV4=10.45.1.1

REQUIRED_SMOKE_GATES=UE_USER_PLANE_INTERFACE_GATE,UE_TO_UPF_ROUTE_GATE,UE_TO_UPF_ICMP_GATE,TUN_TRAFFIC_COUNTER_DELTA_GATE,USER_PLANE_PROCESS_CONTINUITY_GATE,USER_PLANE_FUNCTIONAL_SMOKE_GATE

SMOKE_EVIDENCE_REQUIRED=true
SMOKE_EVIDENCE_LATEST_PATH=/tmp/sci-oran/user-plane-smoke/latest.env
SMOKE_EVIDENCE_MAX_AGE_SECONDS=300
SMOKE_EVIDENCE_MUST_BE_FRESH=true
SMOKE_EVIDENCE_MUST_MATCH_RUNTIME_FINGERPRINT=true

PERSISTENT_RUNTIME_CONFIGURATION_MODIFICATION_ALLOWED=false
DOCTOR_AUTOMATIC_RECOVERY_ALLOWED=false
