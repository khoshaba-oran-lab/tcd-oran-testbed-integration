    "expected_image_id": "required_input",
    "expected_started_at": "required_input"
  },
  "operation_binding": {
    "operation_id": "required_input",
    "window_start": "required_input",
    "window_end": "required_input",
    "expected_min_prbs": "required_input",
    "expected_max_prbs": "required_input"
  },
  "pass_condition": {
    "expected_marker_cardinality": 1
  },
  "fail_closed": [
    "container not running",
    "container image identity mismatch",
    "container incarnation mismatch",
    "authoritative log unavailable",
