{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sci-oran:schema:metadata:1.0.0",
  "title": "Sci_O-RAN Unified Dataset Metadata Schema",
  "description": "Machine-readable metadata contract for Sci_O-RAN dataset, experiment, run, artifact, and processing provenance records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset",
    "experiments",
    "runs",
    "artifacts",
    "processing_provenance"
  ],
  "properties": {
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "experiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experiment"
      },
      "minItems": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "processing_provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/processingProvenance"
      }
    }
  },
  "$defs": {
    "datasetId": {
      "type": "string",
      "pattern": "^DS-[0-9]{8}-[0-9]{3}-[a-z0-9][a-z0-9-]*$"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^EXP-[0-9]{8}-[A-Z0-9]+-[A-Z0-9-]+-R[0-9]{2}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-[0-9]{8}T[0-9]{6}Z-[0-9]{3}$"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "provenanceId": {
      "type": "string",
      "pattern": "^PROV-[0-9]{8}T[0-9]{6}Z-[0-9]{3}$"
    },
    "rfc3339Utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "validationStatus": {
      "type": "string",
      "enum": [
        "not_validated",
        "valid",
        "valid_with_warnings",
        "invalid"
      ]
    },
    "dataLevel": {
      "type": "string",
      "enum": [
        "raw",
        "processed",
        "derived"
      ]
    },
    "clockSyncStatus": {
      "type": "string",
      "enum": [
        "synchronized",
        "partially_synchronized",
        "unsynchronized",
        "unknown",
        "not_applicable"
      ]
    },
    "namespace": {
      "type": "string",
      "enum": [
        "traffic",
        "iperf",
        "netif",
        "rtt",
        "host_cpu",
        "cpu_freq",
        "load",
        "memory",
        "container",
        "native_gnb",
        "oran_kpm",
        "actuator"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_title",
        "dataset_version",
        "schema_version",
        "created_time_utc",
        "experiment_ids",
        "data_levels",
        "description",
        "repository_commit",
        "known_limitations",
        "validation_status"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/datasetId"
        },
        "dataset_title": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "$ref": "#/$defs/datasetVersion"
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "created_time_utc": {
          "$ref": "#/$defs/rfc3339Utc"
        },
        "experiment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/experimentId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "data_levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataLevel"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_status": {
          "$ref": "#/$defs/validationStatus"
        },
        "archival_record": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "record_url": {
              "type": "string"
            },
            "doi": {
              "type": "string"
            }
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "experiment_status",
        "experiment_date_utc",
        "experiment_purpose",
        "configuration_ref",
        "accepted_run_id",
        "evidence_status"
      ],
      "properties": {
        "experiment_id": {
          "$ref": "#/$defs/experimentId"
        },
        "experiment_status": {
          "type": "string",
          "enum": [
            "planned",
            "completed",
            "rejected",
            "legacy"
          ]
        },
        "experiment_date_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "traffic_direction": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "DL",
            "UL",
            "bidirectional",
            "not_applicable",
            null
          ]
        },
        "transport_protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "offered_rate_kbit_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "repeat_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "configured_duration_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "packet_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "experiment_purpose": {
          "type": "string",
          "minLength": 1
        },
        "configuration_ref": {
          "type": "string",
          "minLength": 1
        },
        "accepted_run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/runId"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "FACT",
            "FACT_PARTIAL",
            "HYPOTHESIS",
            "ASSUMPTION"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "experiment_id",
        "run_status",
        "start_time_utc",
        "end_time_utc",
        "host_id",
        "software_commit",
        "configuration_ref",
        "collector_set",
        "clock_sync_status"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "experiment_id": {
          "$ref": "#/$defs/experimentId"
        },
        "run_status": {
          "type": "string",
          "enum": [
            "accepted",
            "completed",
            "aborted",
            "failed",
            "rejected"
          ]
        },
        "start_time_utc": {
          "$ref": "#/$defs/rfc3339Utc"
        },
        "end_time_utc": {
          "anyOf": [
            {
              "$ref": "#/$defs/rfc3339Utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "software_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "configuration_ref": {
          "type": "string",
          "minLength": 1
        },
        "traffic_command": {
          "type": [
            "string",
            "null"
          ]
        },
        "collector_set": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namespace"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "clock_sync_status": {
          "$ref": "#/$defs/clockSyncStatus"
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "experiment_id",
        "run_id",
        "data_level",
        "namespace",
        "relative_path",
        "media_type",
        "byte_size",
        "sha256",
        "schema_version",
        "source_artifact_ids",
        "processing_provenance_id",
        "validation_status"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "experiment_id": {
          "$ref": "#/$defs/experimentId"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/runId"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_level": {
          "$ref": "#/$defs/dataLevel"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/schemaVersion"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactId"
          },
          "uniqueItems": true
        },
        "processing_provenance_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/provenanceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_status": {
          "$ref": "#/$defs/validationStatus"
        }
      }
    },
    "processingProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_provenance_id",
        "process_name",
        "process_type",
        "created_time_utc",
        "input_artifact_ids",
        "output_artifact_ids",
        "software_commit",
        "entrypoint",
        "parameters"
      ],
      "properties": {
        "processing_provenance_id": {
          "$ref": "#/$defs/provenanceId"
        },
        "process_name": {
          "type": "string",
          "minLength": 1
        },
        "process_type": {
          "type": "string",
          "enum": [
            "processing",
            "synchronization",
            "aggregation",
            "analysis",
            "modelling",
            "validation"
          ]
        },
        "created_time_utc": {
          "$ref": "#/$defs/rfc3339Utc"
        },
        "input_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "output_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "software_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "input_schema_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaVersion"
          }
        },
        "output_schema_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/schemaVersion"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "container_image_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
