{
  "dictionary_id": "urn:sci-oran:data-dictionary:1.0.0",
  "dictionary_version": "1.0.0",
  "schema_version": "1.0.0",
  "description": "Canonical field dictionary for the initial Sci_O-RAN unified dataset architecture.",
  "evidence_class_vocabulary": {
    "SOURCE_PROVEN": "Semantics or unit established directly from the exact runtime source revision or authoritative implementation.",
    "RUNTIME_OBSERVED": "Property directly demonstrated in the Tb3 runtime.",
    "DERIVED": "Value calculated deterministically from source, receiver, processed, or other explicitly identified input fields.",
    "HYPOTHESIS": "Interpretation not yet proven and not permitted as an established dataset fact."
  },
  "evidence_model_note": "evidence_class describes the evidential basis of a field definition. It is distinct from experiment-level evidence_status, which describes completeness or acceptability of experimental evidence.",
